PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# JWT
JWT_SECRET=rasaatlas-dev-secret-ganti-di-produksi

# Supabase -> Project Settings -> Database -> Connection string -> URI
# Untuk API Express yang berjalan terus, gunakan Session pooler (port 5432).
# Contoh:
# DATABASE_URL=postgresql://postgres.abcdefghijklmno:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Opsional: jumlah koneksi maksimum di pool (default 10).
# PG_POOL_MAX=10
